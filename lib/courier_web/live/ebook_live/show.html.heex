<div class="flex items-start justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-zinc-900">{@ebook.title}</h1>
    <div class="mt-2 flex items-center gap-3 flex-wrap">
      <span class={[
        "inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium capitalize",
        status_class(@ebook.status)
      ]}>
        {@ebook.status}
      </span>
      <span :if={@ebook.archived} class="text-xs text-zinc-500">Archived to library</span>
      <span class="text-xs text-zinc-500">{length(@ebook.articles)} articles</span>
      <span :if={duration(@ebook)} class="text-xs text-zinc-500">{duration(@ebook)}</span>
    </div>
  </div>
  <div class="flex items-center gap-3 shrink-0">
    <.button
      :if={@ebook.status == "failure"}
      phx-click="retry"
      phx-disable-with="Retrying…"
    >
      Retry
    </.button>
    <.link navigate={~p"/ebooks"} class="text-sm text-zinc-500 hover:text-zinc-700">
      ← Ebooks
    </.link>
  </div>
</div>

<div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-4">
    <div class="bg-white rounded-lg border border-zinc-200 p-4">
      <h2 class="text-sm font-semibold text-zinc-900">Articles</h2>
      <ol class="mt-3 space-y-2 list-none">
        <li :for={article <- @ebook.articles} class="flex items-baseline gap-2 text-sm">
          <span class="text-zinc-400 tabular-nums w-5 shrink-0 text-right">
            {article.position + 1}.
          </span>
          <a
            href={article.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-600 hover:underline break-all"
          >
            {article.url}
          </a>
        </li>
      </ol>
    </div>

    <div :if={@ebook.log_output} class="rounded-lg border border-zinc-200 overflow-hidden">
      <details open={@ebook.status == "failure"}>
        <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-zinc-700 bg-white hover:bg-zinc-50 select-none list-none flex justify-between items-center">
          Log output
          <span class="text-zinc-400 text-xs font-normal">click to toggle</span>
        </summary>
        <pre class="px-4 pb-4 pt-2 text-xs text-zinc-600 bg-zinc-50 overflow-x-auto whitespace-pre-wrap">{@ebook.log_output}</pre>
      </details>
    </div>
  </div>

  <div>
    <div class="bg-white rounded-lg border border-zinc-200 p-4">
      <h2 class="text-sm font-semibold text-zinc-900">Send to Device</h2>

      <p :if={@ebook.status == "running"} class="mt-3 text-sm text-zinc-500 italic">
        Creating ebook…
      </p>

      <p :if={@ebook.status == "pending"} class="mt-3 text-sm text-zinc-500 italic">
        Waiting to start…
      </p>

      <p :if={@ebook.status == "failure"} class="mt-3 text-sm text-zinc-500">
        Ebook creation failed — see log for details.
      </p>

      <div :if={@ebook.status == "success"}>
        <p :if={@devices == []} class="mt-3 text-sm text-zinc-500">
          No devices configured.
          <.link navigate={~p"/devices/new"} class="underline hover:text-zinc-700">Add one</.link>.
        </p>

        <div
          :for={device <- @devices}
          class="mt-4 first:mt-3 flex items-center justify-between gap-4"
        >
          <div class="min-w-0">
            <div class="text-sm font-medium text-zinc-900 truncate">{device.name}</div>
            <div class="text-xs text-zinc-500 mt-0.5">
              {send_label(@sends_by_device[device.id])}
            </div>
          </div>
          <.button
            phx-click="send_to_device"
            phx-value-device_id={device.id}
            disabled={send_running?(@sends_by_device[device.id])}
            class="shrink-0 text-sm"
          >
            {if already_sent?(@sends_by_device[device.id]), do: "Resend", else: "Send"}
          </.button>
        </div>
      </div>
    </div>
  </div>
</div>
